{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "FlowDesk Suite Corporativa",
  "version": "5.2.3",
  "icons": {
    "16": "icons/flowdesk-128x128-claro.png",
    "32": "icons/flowdesk-128x128-claro.png",
    "48": "icons/flowdesk-128x128-claro.png",
    "128": "icons/flowdesk-128x128-claro.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowDesk",
    "default_icon": {
      "16": "icons/flowdesk-128x128-claro.png",
      "32": "icons/flowdesk-128x128-claro.png",
      "48": "icons/flowdesk-128x128-claro.png",
      "128": "icons/flowdesk-128x128-claro.png"
    }
  },
  "commands": {
    "abrir-painel-financeiro": {
      "suggested_key": {
        "default": "Ctrl+1"
      },
      "description": "Abrir painel financeiro"
    },
    "abrir-bloco-notas": {
      "suggested_key": {
        "default": "Ctrl+2"
      },
      "description": "Abrir bloco de notas"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hyperflow.global/*",
        "*://*.sereduc.com/*",
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*"
      ],
      "run_at": "document_end",
      "js": [
        "content/config.js",
        "content/storage.js",
        "content/utils.js",
        "content/icons/lucide.js",
        "content/global-state.js",
        "content/services/toast.js",
        "content/services/modal.js",
        "content/services/holiday.js",
        "content/services/groq.js",
        "content/modules/auth.js",
        "content/modules/fin-module.js",
        "content/modules/notes-module.js",
        "content/modules/speed-dial.js",
        "content/main.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://script.google.com/*",
    "https://calendar.google.com/*",
    "https://www.generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [{
    "resources": ["content/styles/*.css"],
    "matches": [
      "<all_urls>"
    ]
  }]
}